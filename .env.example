# StudentTask: contoh konfigurasi. Salin ke .env (cp .env.example .env) lalu isi.
# .env TIDAK boleh di-commit. Hanya nilai LOKAL/sintetis; jangan pakai rahasia dari tempat lain.
# Variabel bertanda (WAJIB) membuat `docker compose up` gagal bila kosong.

# ---------- Database (WAJIB) ----------
DB_NAME=studenttask
DB_USERNAME=studenttask
# Isi password acak sendiri (mis. `openssl rand -base64 24`). Jangan memakai tanda kutip/spasi.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------- Autentikasi (WAJIB) ----------
# Rahasia penanda JWT HS256, minimal 32 byte acak: `openssl rand -base64 48`
JWT_SECRET=
# Origin frontend yang diizinkan (CORS + cek Origin refresh/logout), dipisah koma, tanpa slash akhir.
# Harus sama persis dengan alamat yang dibuka di browser (localhost dan 127.0.0.1 dianggap BERBEDA).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Flag Secure pada cookie refresh. Default true. Chrome tetap menerima cookie Secure di http://localhost
# dan http://127.0.0.1; Safari TIDAK, jadi isi false hanya bila memakai Safari lewat http lokal.
# Wajib true bila aplikasi diakses lewat HTTPS / online.
AUTH_REFRESH_COOKIE_SECURE=true

# ---------- Frontend / backend (BACKEND_URL WAJIB) ----------
# Alamat backend yang dipakai frontend untuk proxy /api/*, dibaca saat BUILD dan runtime.
# Di Compose: alamat internal service. Mengubahnya butuh `docker compose build frontend`.
BACKEND_URL=http://backend:8080
# Port host (selalu terikat ke 127.0.0.1). Ubah bila bentrok atau menjalankan stack kedua.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ---------- Telegram (opsional; kosong = fitur Telegram nonaktif) ----------
# Token dari @BotFather. RAHASIA.
TELEGRAM_BOT_TOKEN=
# Username bot tanpa @, dipakai membuat deep link.
TELEGRAM_BOT_USERNAME=
# Wajib cocok [A-Za-z0-9_-]{32,256} (mis. `openssl rand -hex 32`); bila terisi dengan format lain
# backend GAGAL start. Dipakai verifikasi webhook; boleh kosong pada mode polling.
TELEGRAM_WEBHOOK_SECRET=
# polling (default, satu instance, cocok lokal) atau webhook (online; butuh HTTPS publik).
TELEGRAM_MODE=polling
# Origin HTTPS publik backend; hanya dipakai bila TELEGRAM_MODE=webhook. Kosongkan untuk polling.
TELEGRAM_PUBLIC_BASE_URL=

# ---------- Reminder ----------
# false = matikan polling reminder dan pembersihan harian.
REMINDER_SCHEDULER_ENABLED=true
# Interval pengecekan, ISO-8601 duration.
REMINDER_POLL_INTERVAL=PT60S
# Pembersihan harian, cron Spring 6 field, zona UTC (default 03:30 UTC).
REMINDER_CLEANUP_CRON="0 30 3 * * *"

# ---------- Opsional ----------
# Ganti nama project Compose (mis. untuk stack verifikasi kedua dengan volume terpisah).
# COMPOSE_PROJECT_NAME=task-reminder
# Catatan: TELEGRAM_API_BASE (https:// saja) dan TELEGRAM_RUNNERS_ENABLED dibaca aplikasi tetapi TIDAK
# diteruskan oleh docker-compose.yml; tidak perlu diisi untuk pemakaian normal.
